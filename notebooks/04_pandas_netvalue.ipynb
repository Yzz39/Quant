   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"../data/sample_etf_daily_long.csv\")\n",
    "\n",
    "df[\"return\"] = df[\"close\"].pct_change()\n",
    "df[\"net_value\"]=(1+df[\"return\"]).cumprod()\n",
    "df[\"cum_return\"]=df[\"net_value\"]-1\n",
    "df[[\"net_value\",\"cum_return\"]]\n"
   ]
  }
 ],
